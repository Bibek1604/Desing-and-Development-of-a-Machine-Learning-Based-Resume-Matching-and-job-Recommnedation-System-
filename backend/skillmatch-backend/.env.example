# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL (the only supported database) ─────────────────────────────────
# Create the database once with:
#     psql -U postgres -c "CREATE DATABASE skillmatch;"
DB_NAME=skillmatch
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Connection handling
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=10
DB_ATOMIC_REQUESTS=1

# Alternatively set a single URL, which overrides the six values above:
# DATABASE_URL=postgresql://user:password@host:5432/skillmatch

# ── CORS (Next.js frontend) ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Matching engine ──────────────────────────────────────────────────────────
# tfidf (default, fully supported) | semantic | hybrid
MATCHER_BACKEND=tfidf

# ── Redis (optional; off by default) ─────────────────────────────────────────
USE_REDIS=0
REDIS_URL=redis://localhost:6379/0

# ── API rate limiting ────────────────────────────────────────────────────────
THROTTLE_ANON=120/min
THROTTLE_USER=600/min

# ── Upload limits ────────────────────────────────────────────────────────────
MAX_RESUME_UPLOAD_MB=5

# ── Email (production) ───────────────────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
