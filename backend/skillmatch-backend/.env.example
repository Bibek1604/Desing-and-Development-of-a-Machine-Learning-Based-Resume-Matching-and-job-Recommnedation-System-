# Django
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (default database)
DB_NAME=skillmatch
DB_USER=skillmatch
DB_PASSWORD=skillmatch
DB_HOST=localhost
DB_PORT=5432

# Set to 1 only for a quick SQLite dev run / tests (Postgres is the real default)
USE_SQLITE=0

# CORS (Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Matching engine backend: tfidf (default) | semantic (future: Sentence-BERT)
MATCHER_BACKEND=tfidf  # default; semantic|hybrid (SBERT) are opt-in

# SQLite override (used with USE_SQLITE=1; defaults to ./db.sqlite3)
# SQLITE_PATH=/path/to/db.sqlite3

# Redis (cache, sessions, Celery). REMOVED FOR NOW — defaults to 0 everywhere.
# Opt back in with USE_REDIS=1 (falls back to LocMem cache + DB sessions otherwise).
USE_REDIS=0
REDIS_URL=redis://localhost:6379/0

# API rate limiting (DRF throttling)
THROTTLE_ANON=120/min
THROTTLE_USER=600/min

# Email (production)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
