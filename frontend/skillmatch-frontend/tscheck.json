{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "app/**/*.tsx",
    "app/**/*.ts",
    "lib/**/*.ts",
    "context/**/*.tsx",
    "components/**/*.tsx"
  ]
}
